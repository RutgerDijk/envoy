{
  "skill": "review",
  "agentInvariants": [
    {
      "matchDescription": "Cleanup pass",
      "matchTaskId": "^cleanup$",
      "subagentType": "general-purpose",
      "promptMustContain": ["git diff main...HEAD", "Never change functionality"],
      "promptMustNotContain": []
    },
    {
      "matchDescription": "AI code review",
      "matchTaskId": "^ai-review$",
      "subagentType": "envoy:code-reviewer",
      "promptMustContain": ["iterative-retrieval.md", "read-only review", "git diff main...HEAD"],
      "promptMustNotContain": [],
      "forbiddenTools": ["Edit", "Write"]
    }
  ],
  "requiredArtifacts": [
    { "path": ".envoy/active-skill.json", "committed": false },
    { "path": ".envoy/review/handoff-to-finalize.json", "committed": false }
  ],
  "loopSignals": [],
  "handoffOut": ".envoy/review/handoff-to-finalize.json"
}
