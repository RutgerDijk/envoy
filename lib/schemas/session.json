{
  "$schemaVersion": "1",
  "$id": "envoy/session",
  "description": "Pickup task-list snapshot — preflight-seeded, write-once; lives at .envoy/pickup/session.json. Distinct from the live repo-root .envoy-session.json that lib/session-state.js reads and writes throughout a run (task status, decisions, chosen worker model).",
  "type": "object",
  "required": ["$schemaVersion", "branch", "tasks"],
  "properties": {
    "$schemaVersion": { "type": "string", "const": "1" },
    "branch": { "type": "string" },
    "plan": { "type": "string" },
    "issueNumber": { "type": "number" },
    "startedAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["pending", "in_progress", "done", "blocked"] },
          "commitSha": { "type": "string" },
          "blocker": { "type": "string" }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "nextSteps": { "type": "array", "items": { "type": "string" } }
  }
}
